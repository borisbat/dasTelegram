options gen2

require daslib/daspkg

[export]
def package() {
    package_name("das-telegram")
    package_author("borisbat")
    package_description("Telegram Bot API bindings for daslang — zero-DOM JSON via sscan_json/sprint_json")
    package_source("github.com/borisbat/dasTelegram")
    package_license("BSD-3-Clause")
    package_tag("telegram")
    package_tag("bot")
    package_tag("api")
}

[export]
def resolve(sdk_version, version : string) {
    if (empty(version) || version == "latest") {
        download_branch("main")
    } else {
        download_tag("v{version}")
    }
}
